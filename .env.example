# Copia este fichero a .env y cambia las contraseñas.
# Las contraseñas de los roles solo admiten [A-Za-z0-9_-.] (8-64 caracteres),
# porque se insertan en scripts SQL de inicialización.

# --- PostgreSQL (administrador del contenedor; NO lo usa el agente) ---
POSTGRES_USER=dataops_admin
POSTGRES_PASSWORD=cambia_admin_123
POSTGRES_DB=dataops
DATAOPS_PG_PUERTO=5432
# 127.0.0.1 y no localhost: en Windows, localhost va primero a IPv6 y cada conexión espera
DATAOPS_PG_HOST=127.0.0.1

# --- Roles que usa el servidor MCP ---
DATAOPS_LECTOR_USUARIO=dataops_lector
DATAOPS_LECTOR_PASSWORD=cambia_lector_123
DATAOPS_ESCRITOR_USUARIO=dataops_escritor
DATAOPS_ESCRITOR_PASSWORD=cambia_escritor_123

# Esquema aislado del proyecto (un esquema por proyecto)
DATAOPS_ESQUEMA=proyecto_demo

# --- Metabase ---
# Base de datos interna de Metabase (sus metadatos), dentro del mismo PostgreSQL
MB_APP_BD=metabase_app
MB_APP_USUARIO=metabase_app
MB_APP_PASSWORD=cambia_mbapp_123
METABASE_PUERTO=3000
METABASE_URL=http://127.0.0.1:3000
# Cuenta administradora de Metabase que crea scripts/configurar_metabase.py
METABASE_USUARIO=admin@dataops.local
METABASE_PASSWORD=Cambia-Metabase-2026
# Opcional: clave de API de Metabase (si se define, se usa en lugar de usuario/contraseña)
METABASE_API_KEY=
